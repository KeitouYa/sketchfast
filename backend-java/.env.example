# Copy to .env (gitignored). Spring reads it via spring.config.import in application.yml.
# Real environment variables win over this file.

# MongoDB replica set (docker compose up -d at the repo root starts one on 27017)
MONGODB_URI=mongodb://localhost:27017/aiimage?replicaSet=rs0&directConnection=true

# Redis, used as a cache (docker compose starts one on host port 6380)
REDIS_URL=redis://localhost:6380

# Clerk: the instance URL, i.e. the "iss" claim of session tokens.
# The session token must carry "email" and "name": Clerk dashboard -> Sessions -> Customize session token.
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Replicate (image model). https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Only needed when Replicate can reach this backend; from GET https://api.replicate.com/v1/webhooks/default/secret
REPLICATE_WEBHOOK_SECRET=
# Public URL of this backend, used for Replicate's webhook. Leave blank locally: results are polled instead.
PUBLIC_BASE_URL=

# Cloudinary (stores finished images as WebP)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Prompt rewriting and translation: Gemini first, OpenAI as the fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# Stripe, test mode keys (sk_test_...). Without a key, buying credits returns an error and everything else works.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8080/api/webhooks/stripe`. Optional locally:
# the success page also confirms the payment.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the user back after paying
FRONTEND_URL=http://localhost:3000
