# Copy to .env (gitignored). Spring reads it via spring.config.import in application.yml.
# Real environment variables win over this file.

# MongoDB replica set (docker compose up -d at the repo root starts one on 27017)
MONGODB_URI=mongodb://localhost:27017/aiimage?replicaSet=rs0&directConnection=true

# Clerk: the instance URL, i.e. the "iss" claim of session tokens
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
