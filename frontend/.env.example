# Copy to .env.local (gitignored).

# The backend that serves /api/** (Next.js forwards those requests to it).
# The Spring Boot backend in ../backend-java runs on 8080.
API_URL=http://localhost:8080

# Clerk. Get both keys from https://dashboard.clerk.com/ (the same instance as CLERK_ISSUER in the backend).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
